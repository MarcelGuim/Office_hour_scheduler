{
  "name": "office-hours-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "seed:professors": "node --env-file-if-exists=../.env scripts/seed-professors.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 'test/**/*.test.js'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
