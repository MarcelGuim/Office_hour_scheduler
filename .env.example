# Local development only. Copy to .env (git-ignored) and change the values:
#   cp .env.example .env
# Read by docker-compose.yml and by the backend npm scripts (they load ../.env).
# The cluster does not use this file: it gets these values from a ConfigMap and a Secret.

# --- PostgreSQL (required) ---
DB_NAME=office_hours
DB_USER=office_hours
DB_PASSWORD=change-me-locally
# Port published on the laptop (127.0.0.1 only). Change it if 5432 is already in use.
DB_PORT=5432

# --- Auth (required) ---
# At least 32 characters; the backend refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- Offer emails ---
# Base URL of the links in offer emails.
PUBLIC_BASE_URL=http://localhost:8080
# Offer window in seconds (default 300). Lower it to test offer rounds faster.
# OFFER_WINDOW_SECONDS=60

# Gmail API (OAuth client of a Google Cloud project, scope gmail.send). Sent over HTTPS
# because DigitalOcean blocks outbound SMTP. Leave GMAIL_REFRESH_TOKEN empty to print emails
# to the log instead (read them at http://localhost:8080/mailbox.html with Compose).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional sender, e.g. Office Hours <you@gmail.com>. The address must be the authorised
# Gmail account. Empty: Gmail uses that account's address.
EMAIL_FROM=

# --- Professor accounts (for: cd backend && npm run seed:professors) ---
# JSON array on one line, single-quoted. Use your own local passwords.
SEED_PROFESSORS='[{"name":"Ada Lovelace","email":"ada@example.com","password":"change-me-locally"}]'
